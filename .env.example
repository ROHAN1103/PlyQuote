# Copy to .env and fill in. Never commit .env.
# Use URL-safe values (letters/digits, e.g. `openssl rand -hex 24`) for POSTGRES_PASSWORD:
# it is embedded in a connection URL.
POSTGRES_DB=pqb
POSTGRES_USER=pqb
POSTGRES_PASSWORD=

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ENVIRONMENT=development      # production in production
COOKIE_SECURE=false          # true in production
ENABLE_DOCS=true
LOG_LEVEL=INFO
HTTP_PORT=8080               # development only
