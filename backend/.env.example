# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO
ENABLE_DOCS=true                 # set false in production if you do not want /api/v1/docs exposed

# Used when running the backend directly (outside Docker). Docker Compose builds this from POSTGRES_* in the root .env.
DATABASE_URL=postgresql://pqb:change-me@localhost:5432/pqb

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

COOKIE_SECURE=false              # must be true in production (HTTPS)
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
MIN_PASSWORD_LENGTH=12

# Where uploaded files (company logo) are stored. A Docker volume in production.
UPLOAD_DIR=./data/uploads
